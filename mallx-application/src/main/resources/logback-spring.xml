    <!-- 售后模块日志输出器：com.mallx.aftersale 包日志 -->
    <appender name="MALL_AFTER_SALE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/mall-after-sale/mall-after-sale.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/mall-after-sale/archive/mall-after-sale.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 后台管理模块日志输出器：com.mallx.admin 包日志 -->
    <appender name="MALL_ADMIN" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/mall-admin/mall-admin.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/mall-admin/archive/mall-admin.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 智能模块日志输出器：com.mallx.ai 包日志 -->
    <appender name="MALL_AI" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/mall-ai/mall-ai.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/mall-ai/archive/mall-ai.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 以下 logger 按包名路由日志：
         additivity="false" 表示禁止向上传递，日志只写入此处指定的输出器，
         避免与 root 重复输出；同时每个模块日志都会打印到控制台 -->
    <logger name="com.mallx.common" level="INFO" additivity="false">
        <appender-ref ref="MALL_COMMON"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.auth" level="INFO" additivity="false">
        <appender-ref ref="MALL_AUTH"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.user" level="INFO" additivity="false">
        <appender-ref ref="MALL_USER"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.product" level="INFO" additivity="false">
        <appender-ref ref="MALL_PRODUCT"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.inventory" level="INFO" additivity="false">
        <appender-ref ref="MALL_INVENTORY"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.cart" level="INFO" additivity="false">
        <appender-ref ref="MALL_CART"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.order" level="INFO" additivity="false">
        <appender-ref ref="MALL_ORDER"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.payment" level="INFO" additivity="false">
        <appender-ref ref="MALL_PAYMENT"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.coupon" level="INFO" additivity="false">
        <appender-ref ref="MALL_COUPON"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.seckill" level="INFO" additivity="false">
        <appender-ref ref="MALL_SECKILL"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.search" level="INFO" additivity="false">
        <appender-ref ref="MALL_SEARCH"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.aftersale" level="INFO" additivity="false">
        <appender-ref ref="MALL_AFTER_SALE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.admin" level="INFO" additivity="false">
        <appender-ref ref="MALL_ADMIN"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.mallx.ai" level="INFO" additivity="false">
        <appender-ref ref="MALL_AI"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 根日志：框架和三方库默认只记录WARN及以上，避免普通INFO淹没业务日志 -->
    <root level="WARN">
        <appender-ref ref="APPLICATION"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
